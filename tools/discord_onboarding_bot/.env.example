DISCORD_TOKEN=

# Optional but recommended. If set, slash commands sync instantly to this guild.
DISCORD_GUILD_ID=

# Optional welcome channel. The current flow posts directly in the intro channel.
WELCOME_CHANNEL_ID=
WELCOME_CHANNEL_NAME=welcome_new_members

# Required intro channel. Use ID or name.
INTRO_CHANNEL_ID=
INTRO_CHANNEL_NAME=hackathon-intros

# Optional. If omitted, the bot looks for or creates a role named HACKATHON_ROLE_NAME.
HACKATHON_ROLE_ID=
HACKATHON_ROLE_NAME=Hackathon
JOIN_EMOJI=✅
ROLE_ADD_EMOJI=✅
ROLE_REMOVE_EMOJI=❌

# Optional channels. Use IDs or names.
GENERAL_CHANNEL_ID=
GENERAL_CHANNEL_NAME=
TARGET_CLAIMS_CHANNEL_ID=
TARGET_CLAIMS_CHANNEL_NAME=
BOARD_HELP_CHANNEL_ID=
BOARD_HELP_CHANNEL_NAME=

# Optional links shown in starter messages.
PARTICIPANT_FORM_URL=
HF_ORG_URL=https://huggingface.co/AIFoundry-hackathon
GITHUB_REPO_URL=https://github.com/aifoundry-org/hf-hackathon
DISCORD_EVENT_URL=

# Set to true if intro-channel auto-replies are desired after users post intros.
AUTO_REPLY_TO_INTROS=false

# Delete per-user intro nudges after 24 hours by default.
INTRO_NUDGE_TTL_SECONDS=86400
